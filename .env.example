# M365(Entra) Graph API 연동용. M365 를 안 쓰면 비워둬도 된다.
# 앱 등록 권한: 계정 처리엔 User.ReadWrite.All, 메일 읽기엔 Mail.Read (모두 Application, 관리자 동의)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# 메일에서 퇴사자 가져오기용
M365_MAILBOX=              # 읽을 메일함 주소 (테스트는 네 계정, 예: me@bdo.kr)
MAIL_SUBJECT_KEYWORD=퇴사,퇴직  # 제목에 이 중 하나라도 있으면 대상(쉼표로 여러 개)
MAIL_SENDER=              # 보낸사람 필터(비우면 발신자 안 따짐). 바뀔 수 있으면 비워두세요
MAIL_SINCE_DAYS=30        # 최근 며칠 이내 메일만 조회

# (선택) 이미 로그인해 둔 크롬/엣지에 붙어서 쓰고 싶을 때만 설정.
# 비워두면 Playwright 전용 창을 새로 띄우고, 그 창에서 로그인하면 된다.
# 붙이려면 브라우저를 아래처럼 원격 디버깅 포트로 실행한 뒤 값을 넣는다.
#   엣지:  msedge.exe --remote-debugging-port=9222 --user-data-dir="C:\edge-debug"
#   크롬:  chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-debug"
# BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_CDP_URL=
